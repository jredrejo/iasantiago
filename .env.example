TZ=Europe/Madrid

# ============================================================
# vLLM - MODELO
# ============================================================
# Ruta HF de los pesos.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Nombre con el que vLLM publica el modelo en su API (--served-model-name).
# Deliberadamente independiente de VLLM_MODEL: al cambiar de modelo base no hay
# que tocar Open WebUI. Es el nombre que viaja en el campo "model" de las
# peticiones; la ruta HF de arriba da 404. Sin definir se usa "santiago".
VLLM_SERVED_MODEL=santiago
VLLM_DTYPE=bfloat16                      # Dtype origen antes de cuantizar

# ============================================================
# vLLM - MEMORIA Y RENDIMIENTO
# ============================================================
# Subirlo deja menos VRAM para embedder y reranker: si los pones en "cuda"
# (ver EMBEDDING_DEVICE / RERANK_DEVICE abajo), baja este número.
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_TOKENS=4096
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_LOGGING_LEVEL=INFO
VLLM_MAX_NUM_SEQS=16                     # (1, 2, 4, 8, 16, 24) no pierden el fast path de cuda graph
VLLM_KV_CACHE_DTYPE=fp8_e4m3

# ============================================================
# RAG - LÍMITES DE CONTEXTO
# ============================================================
CTX_TOKENS_SOFT_LIMIT=4000               # Contexto devuelto en modo respuesta
CTX_TOKENS_GENERATIVE=8000               # Contexto devuelto en modo generativo

# Los parámetros de muestreo (temperature, top_p, top_k, repetition_penalty) y
# el presupuesto de max_tokens NO se configuran aquí: 
# los decide Open WebUI por modelo
# de workspace. Ver rag-api/tests/test_surface_after_ripout.py.

# ============================================================
# RAG - RETRIEVAL
# ============================================================
FINAL_TOPK=12                            # Chunks que sobreviven al reranker
GENERATIVE_TOPK_MULTIPLIER=4             # En modo generativo: FINAL_TOPK x este factor
MAX_CHUNKS_PER_FILE=8                    # Tope por fichero, para que uno solo no cope el contexto
MAX_CHUNKS_PER_FILE_GENERATIVE=12
HYBRID_DENSE_K=40                        # Candidatos de la rama densa
HYBRID_BM25_K=40                         # Candidatos de la rama léxica (vector disperso)
BM25_FALLBACK_TOKEN_THRESHOLD=0          # >0: consultas más cortas van solo por la rama léxica

# ============================================================
# EMBEDDINGS Y RERANKING
# ============================================================
EMBED_MODEL_DEFAULT=intfloat/multilingual-e5-large-instruct
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Embedders por tema (opcional; COMENTAR para usar el default.
# OJO: dejarlo vacío NO cae al default -- os.getenv devuelve "" y rompe.)
# EMBED_MODEL_PROGRAMMING=thenlper/gte-large
# EMBED_MODEL_CHEMISTRY=hkunlp/instructor-large
# Alternativa: BAAI/bge-reranker-large
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============================================================
# INFRAESTRUCTURA
# ============================================================
# === Qdrant ===
QDRANT_STORAGE=/opt/iasantiago-rag/data/storage
QDRANT_URL=http://qdrant:6333

# Telemetría (ruta DENTRO del contenedor, montada desde volumen)
TELEMETRY_PATH=/data/telemetry/retrieval.jsonl


# === Estado del ingestor ===
# Ruta del HOST: sólo la usa compose como origen del bind mount. NO es la ruta
# que ve el código. Si se pusiera aquí una ruta de contenedor, compose montaría
# un directorio vacío del host y el fallo sería silencioso.
INGESTOR_STATE_HOST_DIR=/opt/iasantiago-rag/data/ingestor-state

# ========= TEMAS =========
# Ruta del HOST: origen del bind mount hacia /topics (ver nota de arriba).
TOPICS_HOST_DIR=/opt/iasantiago-rag/topics
# Etiquetas de tema. Las leen el ingestor (qué carpetas indexar) y rag-api
# (validar el `topic` que llega a /retrieve).
TOPIC_LABELS="Chemistry,Electronics,Programming,Sostenibilidad"

# ========= SECURITY / AUTH =========
# OAuth2-Proxy. Estas cuatro se usan por interpolación ${...} en los flags
# `command:` del servicio oauth2-proxy, NO como variables de entorno: ese
# servicio no lleva `env_file`, así que nunca ve este fichero. El resto de su
# configuración vive en oauth2-proxy/oauth2-proxy.cfg.
OAUTH2_CLIENT_ID=CHANGEME_GOOGLE_CLIENT_ID
OAUTH2_CLIENT_SECRET=CHANGEME_GOOGLE_CLIENT_SECRET
OAUTH2_REDIRECT_URL=https://ia.ejemplo.net/oauth2/callback
OAUTH2_EMAIL_DOMAINS=ejemplo.net
# Genera 32 bytes aleatorios en hex para OAUTH2_COOKIE_SECRET
# python -c "import secrets; print(secrets.token_hex(16))"
OAUTH2_COOKIE_SECRET=CALCULA_USANDO_EL_COMANDO_ANTERIOR

# nginx corre en el HOST, no en compose, y lleva las rutas de sus certificados
# escritas a mano en nginx/nginx.conf (nginx no interpola el entorno en su
# config). El puerto de Open WebUI también está fijo en docker-compose.yml,
# atado a 127.0.0.1 a propósito para no exponerlo a la LAN.

# ========= BACKUP =========
BACKUP_DIR=/opt/backups/rag-system

# === OpenAI compat ===
# OPENAI_API_KEY sí sigue viva: es la credencial que /retrieve exige a quien llama.
OPENAI_API_KEY=dummy-key

# CUDA Configuration
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:256,roundup_power2_divisions:16
CUDA_LAUNCH_BLOCKING=0

# Para RTX 5090 (Blackwell): 120
# Para RTX 4090/4080/4070: 8.9
# Para RTX 3090/3080/3070: 8.6
# Para RTX 2080/2070: 7.5
# Para GTX 1080/1070: 6.1
# Si no estás seguro, deja en blanco o usa "native"
TORCH_CUDA_ARCH_LIST=native

# Embedding Configuration
# Opciones: "cuda" o "cpu". Lo lee ModelCache._get_device (core/cache.py).
# "cuda" sólo si queda VRAM: con VLLM_GPU_MEMORY_UTILIZATION alto no la hay.
EMBEDDING_DEVICE=cpu

# Dtype para embeddings
# Opciones: "float16" (ahorra memoria) o "float32" (más estable)
EMBEDDING_DTYPE=float32

# Reranker. Mismo criterio que EMBEDDING_DEVICE: en CPU la latencia es asumible
# con lotes pequeños (<=36 pares); en "cuda" compite con vLLM por la VRAM.
RERANK_DEVICE=cpu

# Debug CUDA (descomenta para debugging)
# CUDA_LAUNCH_BLOCKING=1
# TORCH_USE_CUDA_DSA=1

# ============================================================
# EXTRACCIÓN (ingestor)
# ============================================================
UNSTRUCTURED_LANGUAGES=spa,eng
UNSTRUCTURED_FALLBACK_LANGUAGE=eng
UNSTRUCTURED_DISABLE_CUDA=0
UNSTRUCTURED_ENABLE_CUDA=true

DOCLING_GPU_MEMORY_FRACTION=0.30

QDRANT_COLLECTION_SUFFIX=_v2
# El ingestor escribe el vector disperso junto al denso en un solo upsert.
SPARSE_ENABLED=true
